# Secret values of NutriTrace in Kubernetes. Copy this file to k8s/secrets.env (ignored by
# git, never commit it), fill it in, then create the Secret (see k8s/README.md):
#   kubectl create secret generic nutritrace-secrets -n nutritrace --from-env-file=k8s/secrets.env

# In the NutriTrace folder: php artisan key:generate --show
APP_KEY=
# MySQL passwords: choose your own (no spaces or quotes).
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Same value as the AI service, if it uses a token (otherwise leave empty).
AI_SERVICE_TOKEN=
