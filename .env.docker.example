# Docker Compose Environment Variables
# Copy this file to .env in the project root and update the values.
# .env is ignored by git: never commit it.

# Application Key (REQUIRED). In the NutriTrace folder run:  php artisan key:generate --show
# and paste the result here (it starts with base64:).
APP_KEY=

# Database passwords (REQUIRED): choose your own, without spaces or quotes.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# AI Service Configuration (optional)
# Set a strong token if you want to secure the AI service (same value in the AI service).
AI_SERVICE_TOKEN=

# Ports on this PC (optional): change them if they are already taken.
APP_PORT=8000
DB_FORWARD_PORT=13306
GRAFANA_PORT=3000

# Grafana admin password (monitoring stack, optional)
GRAFANA_ADMIN_PASSWORD=

# Development only: detailed error pages.
APP_DEBUG=false
