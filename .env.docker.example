# Docker Compose Environment Variables
# Copy this file to .env in the project root and update the values

# Application Key (REQUIRED - generate with: cd NutriTrace && php artisan key:generate)
APP_KEY=base64:REPLACE_WITH_YOUR_GENERATED_KEY

# AI Service Configuration (optional)
# Set a strong token if you want to secure the AI service
AI_SERVICE_TOKEN=

# Database Configuration (optional - defaults are set in docker-compose.yml)
MYSQL_ROOT_PASSWORD=nutritrace_root_password
MYSQL_PASSWORD=nutritrace_password

# For production, use strong passwords like:
# MYSQL_ROOT_PASSWORD=$(openssl rand -base64 32)
# MYSQL_PASSWORD=$(openssl rand -base64 32)
